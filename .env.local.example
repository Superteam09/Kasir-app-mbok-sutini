# Salin file ini menjadi .env.local (lokal) dan isi juga di Environment Variables Netlify saat deploy.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-dengan-anon-key-dari-supabase

# Nama restoran, ditampilkan di judul & landing page pelanggan
NEXT_PUBLIC_RESTO_NAME="Nama Restoran Anda"

# Catatan: harga selalu disimpan dalam USD dan otomatis ditampilkan juga
# perkiraan dalam Riel (KHR). Kurs KHR diatur dari dalam aplikasi (halaman
# Pengaturan, khusus owner) setelah login, bukan lewat environment variable.
